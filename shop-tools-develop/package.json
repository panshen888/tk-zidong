{
  "name": "tiktok-ai-flow",
  "version": "0.1.6",
  "private": true,
  "description": "Electron desktop app for 1688 image-search sourcing workflows.",
  "main": "dist/main/main.js",
  "type": "module",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "npm run build:app && electron-builder --dir --config electron-builder.json",
    "build:app": "tsc && npm run build:electron && vite build",
    "build:electron": "esbuild src/main/main.ts --bundle --platform=node --format=esm --packages=external --external:electron --outfile=dist/main/main.js && esbuild src/preload/preload.ts --bundle --platform=node --format=cjs --packages=external --external:electron --outfile=dist/preload/preload.js",
    "build:excel-service": "esbuild src/main/services/excelService.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/tools/excelService.js",
    "mock:excel": "node scripts/create-mock-excel.cjs",
    "inspect:excel": "node scripts/inspect-output-excel.cjs",
    "probe:1688": "npm run build:excel-service && node scripts/probe-1688-adapter.mjs",
    "verify:excel": "npm run build:excel-service && node scripts/verify-excel-pipeline.mjs",
    "verify:price-three-table": "npm run build:excel-service && node scripts/verify-price-three-table.mjs",
    "export:price-template": "esbuild scripts/export-local-three-table-template.ts --bundle --platform=node --format=esm --packages=external --outfile=.codex-run/dist/export-local-three-table-template.mjs && node .codex-run/dist/export-local-three-table-template.mjs",
    "smoke:price:run-next": "esbuild scripts/smoke-run-price-from-pending.ts --bundle --platform=node --format=esm --packages=external --outfile=.codex-run/dist/smoke-run-price-from-pending.mjs && node .codex-run/dist/smoke-run-price-from-pending.mjs",
    "smoke:price:rerun-failed": "esbuild scripts/smoke-run-price-from-pending.ts --bundle --platform=node --format=esm --packages=external --outfile=.codex-run/dist/smoke-run-price-from-pending.mjs && node .codex-run/dist/smoke-run-price-from-pending.mjs --failed",
    "smoke:miaoshou:listing-edit": "esbuild scripts/smoke-miaoshou-listing-edit.ts --bundle --platform=node --format=esm --packages=external --outfile=.codex-run/dist/smoke-miaoshou-listing-edit.mjs && node .codex-run/dist/smoke-miaoshou-listing-edit.mjs",
    "smoke:miaoshou:prepare-draft": "esbuild scripts/smoke-miaoshou-prepare-draft-retry.ts --bundle --platform=node --format=esm --packages=external --outfile=.codex-run/dist/smoke-miaoshou-prepare-draft-retry.mjs && node .codex-run/dist/smoke-miaoshou-prepare-draft-retry.mjs",
    "smoke:miaoshou:save-drafts": "esbuild scripts/smoke-miaoshou-save-drafts.ts --bundle --platform=node --format=esm --packages=external --outfile=.codex-run/dist/smoke-miaoshou-save-drafts.mjs && node .codex-run/dist/smoke-miaoshou-save-drafts.mjs",
    "smoke:miaoshou:check-readiness": "esbuild scripts/smoke-miaoshou-check-readiness.ts --bundle --platform=node --format=esm --packages=external --outfile=.codex-run/dist/smoke-miaoshou-check-readiness.mjs && node .codex-run/dist/smoke-miaoshou-check-readiness.mjs",
    "smoke:miaoshou:publish": "esbuild scripts/smoke-miaoshou-publish.ts --bundle --platform=node --format=esm --packages=external --outfile=.codex-run/dist/smoke-miaoshou-publish.mjs && node .codex-run/dist/smoke-miaoshou-publish.mjs",
    "smoke:miaoshou:verify-publish": "esbuild scripts/smoke-miaoshou-verify-publish.ts --bundle --platform=node --format=esm --packages=external --outfile=.codex-run/dist/smoke-miaoshou-verify-publish.mjs && node .codex-run/dist/smoke-miaoshou-verify-publish.mjs",
    "smoke:miaoshou:prepare-maintenance": "esbuild scripts/smoke-miaoshou-prepare-maintenance.ts --bundle --platform=node --format=esm --packages=external --outfile=.codex-run/dist/smoke-miaoshou-prepare-maintenance.mjs && node .codex-run/dist/smoke-miaoshou-prepare-maintenance.mjs",
    "inspect:miaoshou:listing-edit": "esbuild scripts/inspect-miaoshou-listing-edit-table.ts --bundle --platform=node --format=esm --packages=external --outfile=.codex-run/dist/inspect-miaoshou-listing-edit-table.mjs && node .codex-run/dist/inspect-miaoshou-listing-edit-table.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "dist:mac": "npm run build:app && electron-builder --mac --arm64 --config electron-builder.json",
    "dist:win": "npm run build:app && electron-builder --win --x64 --config electron-builder.win-admin.json",
    "dist:all": "npm run build:app && electron-builder --mac --win --config electron-builder.json"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "electron-store": "^10.0.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "playwright-core": "^1.60.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.13.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  }
}
